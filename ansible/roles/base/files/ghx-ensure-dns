#!/usr/bin/env bash
set -euo pipefail

log() {
  if [[ "${GHX_DEBUG:-}" == "1" ]]; then
    echo "[ghx-ensure-dns] $*" >&2
  fi
}

can_resolve() {
  getent hosts downloadcontent.opensuse.org >/dev/null 2>&1
}

if can_resolve; then
  exit 0
fi

fallback_dns="9.9.9.9"

default_gw="$(ip -4 route show default 2>/dev/null | awk '/^default /{print $3; exit}')"
if [[ -z "${default_gw}" ]]; then
  log "no default gateway yet"
  exit 0
fi

log "cannot resolve; default gateway appears to be $default_gw; will fall back to DNS $fallback_dns"

resolv_conf=/etc/resolv.conf
if [[ ! -e "${resolv_conf}" ]]; then
  : >"${resolv_conf}" 2>/dev/null || true
fi

contents="$(cat "${resolv_conf}" 2>/dev/null || true)"

nameservers=()
while IFS= read -r ns; do
  [[ -n "${ns}" ]] && nameservers+=("${ns}")
done < <(echo "${contents}" | awk '/^nameserver[[:space:]]+/{print $2}' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' || true)

ns_usable=0
for ns in "${nameservers[@]}"; do
  # If we cannot even route to the nameserver, it cannot work.
  if ! ip -4 route get "${ns}" >/dev/null 2>&1; then
    log "nameserver ${ns} is not routable"
    continue
  fi
  # If it is routable but not reachable, also treat it as unusable.
  if ping -c1 -W1 "${ns}" >/dev/null 2>&1; then
    ns_usable=1
    break
  fi
  log "nameserver ${ns} is not reachable"
done

# If there is no usable nameserver and resolution is failing, replace resolv.conf
# with a concrete resolver.
if [[ ${#nameservers[@]} -eq 0 || "${ns_usable}" -eq 0 ]]; then
  if [[ -L "${resolv_conf}" ]]; then
    # Replace symlink with a real file.
    rm -f "${resolv_conf}" 2>/dev/null || true
  fi
  {
    echo "# Generated by ghx-ensure-dns"
    echo "nameserver ${fallback_dns}"
    echo "options timeout:1 attempts:3"
  } >"${resolv_conf}" 2>/dev/null || true
  log "wrote resolv.conf with nameserver ${fallback_dns}"
fi

exit 0
